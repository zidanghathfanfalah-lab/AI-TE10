# ================================================================
# SATRIA — Contoh konfigurasi .env
# Salin ke .env dan isi nilai yang sesuai
# ================================================================

# Redirect Anthropic SDK (used by Band runners) to AIML API
ANTHROPIC_BASE_URL=https://api.aimlapi.com
# Paste your AIML API Key below to authenticate with AIML API's Claude endpoint
ANTHROPIC_API_KEY=your_aiml_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# Featherless AI — baseline clinical analysis (OpenAI-compat, Qwen/DeepSeek)
# Daftar di https://featherless.ai/
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# AIML API — eskalasi P1 + validasi (Gemini/Claude, OpenAI-compat)
# Daftar di https://aimlapi.com/
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL_DEFAULT=gemini-1.5-pro
AIML_MODEL_ESCALATION=claude-sonnet-4-5

# ================================================================
# Band Platform — salin dari https://app.band.ai
# Default mengarah ke Band Cloud; ubah hanya jika self-hosted
# ================================================================
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# Credentials per-agen — diisi dari agent_config.yaml setelah buat agent di Band
# Anamnesis agent ID/key dipakai FastAPI untuk trigger pipeline
ANAMNESIS_AGENT_ID=
ANAMNESIS_API_KEY=
# Clinical Expert ID dipakai FastAPI untuk @mention setelah anamnesis selesai
CLINICAL_EXPERT_AGENT_ID=

# ================================================================
# RAG / ChromaDB
# ================================================================
CHROMADB_PATH=./data/chromadb
CHROMADB_COLLECTION=satria_pnpk
# Direktori dokumen PNPK (PDF/TXT) untuk diindeks oleh ingestion-agent
PNPK_DOCUMENTS_DIR=./knowledge_base/documents

# ================================================================
# Database
# ================================================================
DATABASE_URL=postgresql+asyncpg://satria:password@localhost:5432/satria

# Redis (session store + cache)
REDIS_URL=redis://localhost:6379/1
REDIS_SESSION_TTL=3600

# ================================================================
# Satu Sehat / HL7 FHIR (Sandbox / Staging Environment)
# ================================================================
SATU_SEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATU_SEHAT_CLIENT_ID=
SATU_SEHAT_CLIENT_SECRET=

# App
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4321
